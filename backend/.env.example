# Alphawise Environment Configuration Template
# ============================================

# 1. Groq Cloud API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. LLM Model Selection (Available on Groq)
LLM_MODEL=openai/gpt-oss-120b
# Alternative models on Groq:
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_MODEL=openai/gpt-oss-20b

# 3. Base URL (Defaults to Groq; can be changed to local Ollama if desired)
LLM_BASE_URL=https://api.groq.com/openai/v1
# If using local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
